{
  "name": "smirk-monorepo",
  "version": "0.0.1",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "smirk-monorepo",
      "version": "0.0.1",
      "workspaces": [
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "^5.4.0"
      },
      "engines": {
        "node": ">=20.0.0"
      }
    },
    "node_modules/@smirk/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@smirk/wasm": {
      "resolved": "packages/wasm",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/core": {
      "name": "@smirk/core",
      "version": "0.0.1",
      "license": "MIT",
      "dependencies": {
        "@smirk/wasm": "*"
      }
    },
    "packages/wasm": {
      "name": "@smirk/wasm",
      "version": "0.0.1",
      "license": "MIT"
    }
  }
}
