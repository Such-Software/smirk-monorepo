{
  "name": "@smirk/e2e",
  "version": "0.3.0",
  "private": true,
  "description": "Playwright end-to-end suite: drives the real extension (and later desktop) UI against a running backend. The client-release gate.",
  "type": "module",
  "scripts": {
    "build:ext": "bash scripts/build-extension.sh",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "e2e": "bash scripts/build-extension.sh && playwright test",
    "test:privacy": "node --test scripts/test-private-capture.mjs",
    "test:layout": "playwright test -c playwright.layout.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "esbuild": "^0.21.5"
  }
}
