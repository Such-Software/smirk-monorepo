{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smirk Wallet",
  "version": "0.3.0",
  "identifier": "cash.smirk.wallet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Smirk Wallet",
        "width": 420,
        "height": 700,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "focus": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://api.smirk.cash https://api.trocador.app https://*.smirk.cash https://*.such.software"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "Finance",
    "shortDescription": "Smirk Wallet — multi-asset non-custodial wallet for BTC, LTC, XMR, WOW, and Grin.",
    "longDescription": "Smirk is a non-custodial multi-asset wallet supporting Bitcoin, Litecoin, Monero, Wownero, and Grin. Includes in-wallet swaps (Trocador), social tipping, and a dapp adapter for browser integration. The desktop app shares the same UI as the browser extension.",
    "copyright": "© 2026 Such Software",
    "publisher": "Such Software",
    "homepage": "https://smirk.cash",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "pubkey": "TODO_GENERATE_AND_PASTE_PUBKEY",
      "endpoints": [
        "https://releases.smirk.cash/desktop/{{target}}-{{arch}}/{{current_version}}"
      ]
    }
  }
}
