{
  "name": "@smirk/desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Smirk Wallet desktop shell (Tauri 2.x). Wraps the @smirk/extension popup UI in a native window with a chrome.* compatibility shim so the same React/Preact code path renders on Mac, Windows, and Linux.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "clean": "rm -rf dist src-tauri/target",
    "test": "node --test --import tsx 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@smirk/assets": "*",
    "@smirk/core": "*",
    "@such-software/smirk-dapp-api": "*",
    "@smirk/dapp-browser": "*",
    "@smirk/ui": "*",
    "@smirk/wasm": "*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "preact": "^10.19.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
