{
  "name": "@smirk/core",
  "version": "0.3.0",
  "description": "Smirk wallet core: HD derivation, API client, address codecs, shared types. Consumed by extension, mobile, and desktop clients.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "check:api": "npm run gen:api && git diff --exit-code -- src/api/schema.d.ts",
    "test": "node --test --import tsx --import ./src/__tests__/setup.mjs 'src/**/*.test.ts'",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "libsodium-wrappers": "^0.8.4",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.7.0"
  },
  "dependencies": {
    "@noble/ciphers": "^0.5.0",
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "@scure/base": "^2.0.0",
    "@scure/bip32": "^2.0.1",
    "@scure/bip39": "^2.0.1",
    "@scure/btc-signer": "^1.3.0",
    "@smirk/assets": "*",
    "@smirk/wasm": "*",
    "altcha-lib": "^2.2.0",
    "nostr-tools": "^2.23.9"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
