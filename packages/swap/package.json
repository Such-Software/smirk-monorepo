{
  "name": "@smirk/swap",
  "version": "0.3.0",
  "description": "Swap orchestration with a Trocador quote, trade and status implementation. THORChain and native atomic swaps remain unimplemented.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./thorchain": {
      "types": "./dist/thorchain/index.d.ts",
      "import": "./dist/thorchain/index.js"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsx": "^4.7.0"
  },
  "dependencies": {
    "@smirk/assets": "*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
