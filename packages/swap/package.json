{
  "name": "@smirk/swap",
  "version": "0.3.1",
  "description": "Swap orchestration: Trocador quotes and trades, THORChain vault deposits with a swap memo. Native atomic swaps remain unimplemented.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./thorchain": {
      "types": "./dist/thorchain.d.ts",
      "import": "./dist/thorchain.js"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsx": "^4.7.0"
  },
  "dependencies": {
    "@smirk/assets": "*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
