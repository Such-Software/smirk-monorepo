{
  "name": "@smirk/extension",
  "version": "0.3.0",
  "private": true,
  "description": "Smirk browser extension (Chrome MV3 + Firefox). v0.3 monorepo build — the canonical Smirk client.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "build:chrome": "vite build && cp manifest.json dist/manifest.json",
    "build:firefox": "vite build && cp manifest.firefox.json dist/manifest.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@scure/btc-signer": "^1.3.0",
    "@smirk/assets": "*",
    "@smirk/core": "*",
    "@such-software/smirk-dapp-api": "*",
    "@smirk/ui": "*",
    "@smirk/wasm": "*",
    "preact": "^10.19.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "vite": "^5.4.0"
  }
}
