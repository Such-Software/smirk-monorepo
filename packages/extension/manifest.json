{
  "manifest_version": 3,
  "name": "Smirk Wallet (dev)",
  "version": "0.3.0",
  "description": "Smirk multi-currency wallet — monorepo skeleton build. Not for production use.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "activeTab",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smirk",
    "default_icon": {
      "16": "icons/favicon-16.png",
      "32": "icons/favicon-16.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
