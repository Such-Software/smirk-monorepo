{
  "manifest_version": 3,
  "name": "Smirk Wallet",
  "version": "0.3.0",
  "description": "Non-custodial Bitcoin, Litecoin, Monero, Wownero and Grin wallet with a built-in Nostr identity. Your keys never leave your device.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smirk"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wallet@smirk.cash",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "financialAndPaymentInfo",
          "authenticationInfo",
          "personallyIdentifyingInfo",
          "personalCommunications"
        ]
      }
    }
  }
}
