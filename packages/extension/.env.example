# =========================================================
# Smirk extension — build-time environment variables
# =========================================================
#
# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored. The release pipeline injects production values
# via CI secrets, not via this file.
#
# Reviewer builds (Mozilla AMO, source-distributed audits): leave these
# unset OR copy this template verbatim. The wallet detects a missing
# key and gracefully disables the affected feature with a "not enabled
# in this build" notice, instead of failing at runtime.

# --------------------------
# Trocador (CEX swap aggregator)
# --------------------------
#
# Affiliate API key. Ships in the bundle by design — the wallet talks
# to api.trocador.app directly so the backend never proxies user money
# (Decision 2 in the backend repository's v0.3 plan). This is an
# *affiliate* key, not a bearer credential:
#
#   - A leaked key gives the leaker affiliate rev-share on swaps they
#     route, NOT access to user funds or other users' data.
#   - Trocador rotates keys on request if abuse is detected.
#   - We make no attempt to hide the key in the bundle — obfuscation
#     would be security theater since any debugger can capture the
#     outgoing HTTP header.
#
# To get a key: email commercial@trocador.app for affiliate onboarding.
# Without a key, the Swap tab disables the Trocador entry with a
# "key missing" notice rather than 401-ing at runtime.
#
# Trocador user support (for end users, not affiliate onboarding):
#   - support@trocador.app
#   - @TrocadorSupportBot on Telegram
#   - #Trocador.app:matrix.org on Matrix
# The wallet surfaces these in StatusStep error states automatically.
VITE_TROCADOR_API_KEY=

# --------------------------
# Smirk backend (optional override)
# --------------------------
#
# Backend base URL for the bookkeeping endpoints (POST /api/v1/swaps,
# Trocador webhook receiver, etc.). When unset, falls back to the
# production backend at https://backend.smirk.cash.
# VITE_SMIRK_BACKEND_URL=http://localhost:8080

# --------------------------
# Release-build flag (set ONLY by the release pipeline)
# --------------------------
#
# Triggers the stub-detection guard in popup/index.tsx. Do not set
# locally — the guard exists to catch dev stubs that accidentally
# shipped into a release build. Set by CI.
# VITE_SMIRK_RELEASE=true
