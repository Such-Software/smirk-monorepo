# Smoke-test config. Copy to .env and fill in real values.

# Production backend URL (e.g. https://api.smirk.cash). Use the
# staging URL for dry runs.
SMOKE_BACKEND_URL=https://api.smirk.cash

# 12 or 24 BIP-39 words for each test wallet. Both wallets must be
# pre-registered with the backend (open the extension once with each
# mnemonic so the bootstrap auth flow runs the PoW solve; subsequent
# smoke runs hit the is_returning_user bypass).
#
# These wallets hold real (small) funds: ~$5-10 in BTC / LTC / XMR /
# WOW each. Top up when the health-check Discord post shows a
# balance row approaching dust.
SMOKE_ALICE_MNEMONIC="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"
SMOKE_BOB_MNEMONIC="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"

# Discord webhook URL for failure (and balance-summary) posts. Leave
# blank to log to stderr only.
SMOKE_DISCORD_WEBHOOK_URL=

# Set to 1 to short-circuit any scenario that would broadcast an
# on-chain tx. Useful for local development against production
# without burning fees.
SMOKE_DRY_RUN=0
