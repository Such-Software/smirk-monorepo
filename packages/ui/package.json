{
  "name": "@smirk/ui",
  "version": "0.3.0",
  "description": "Shared Preact components for the Smirk wallet UI — same primitives across extension, mobile (Capacitor), and desktop (Tauri). Asset-registry-driven, no hardcoded chains.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx src/components/__tests__/FreshnessCue.test.tsx src/components/browser/__tests__/BrowserUrlBar.test.tsx src/components/browser/__tests__/BrowserTabStrip.test.tsx src/components/browser/__tests__/BrowserShell.test.tsx",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@smirk/assets": "*",
    "@smirk/core": "*",
    "@smirk/dapp-browser": "*",
    "preact": "^10.19.0"
  },
  "license": "MIT",
  "devDependencies": {
    "preact-render-to-string": "^6.7.0",
    "tsx": "^4.22.4"
  }
}
