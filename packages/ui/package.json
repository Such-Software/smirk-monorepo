{
  "name": "@smirk/ui",
  "version": "0.3.0",
  "description": "Shared Preact components for the Smirk wallet UI — same primitives across extension, mobile (Capacitor), and desktop (Tauri). Asset-registry-driven, no hardcoded chains.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@smirk/assets": "*",
    "@smirk/core": "*",
    "@smirk/dapp-browser": "*",
    "preact": "^10.19.0"
  },
  "license": "MIT"
}
