{
  "name": "@such-software/smirk-dapp-api",
  "version": "0.5.0",
  "description": "Smirk wallet dapp protocol, page adapters, and permission dispatcher for the browser extension and desktop embedded browser. Available methods depend on the page adapter; mobile shell integration is planned.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Such-Software/smirk-monorepo/tree/main/packages/dapp-api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Such-Software/smirk-monorepo.git",
    "directory": "packages/dapp-api"
  },
  "bugs": {
    "url": "https://github.com/Such-Software/smirk-monorepo/issues"
  },
  "keywords": [
    "smirk",
    "wallet",
    "dapp",
    "bitcoin",
    "monero",
    "litecoin",
    "wownero",
    "grin",
    "window.smirk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "devDependencies": {
    "tsx": "^4.7.0"
  }
}
