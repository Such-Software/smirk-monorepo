{
  "name": "@smirk/assets",
  "version": "0.3.0",
  "description": "Asset registry: chain definitions, decimals, families and confirmation policy. Registry entries do not activate client capabilities.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsx": "^4.7.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
