# Paths omitted from `git archive` (the AMO / public source-release zip).
# None of these are build inputs — verified that excluding them does not affect
# `make wasm` or the npm extension build. Keeping them out avoids shipping
# internal security docs, CI/ops details, the committed release binaries, and the
# real-money smoke harness in a public source submission.

# Internal security docs now live in docs/private/ (git-ignored), so they are
# neither tracked in this PUBLIC repo nor shipped in the archive — no export-ignore
# entry is needed for them. NOTE: export-ignore is NOT a privacy control; it only
# trims the AMO source zip. Anything that must stay private must be under a
# git-ignored private/ directory, never merely export-ignored.

# CI / ops internals (runner labels, hostnames, signing-secret names).
.github export-ignore
.gitea  export-ignore

# Committed release artifacts (binaries) — otherwise the source zip embeds a
# copy of itself + the built extensions. Kept tracked as an audit trail, but
# never shipped inside the source archive.
packages/extension/releases export-ignore

# Internal real-money end-to-end tip harness (not an npm workspace; not needed
# to build the extension).
packages/smoke-tests export-ignore

# Leak-firewall scanner: it hardcodes the very identifiers it guards against
# (a nebula lighthouse IP, a test-wallet address, and a test-seed marker) as
# detection regexes, so shipping it would leak them into the public source zip.
# It is a CI / pre-commit tool, not a build input for `make ext-firefox`.
scripts/secret-scan.sh export-ignore
