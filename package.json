{
  "name": "smirk-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Smirk multi-currency wallet — TypeScript workspace root",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*"
